#!/bin/sh
# Rejects commit messages that violate CLAUDE.md git conventions:
# no AI attribution trailers, no em or en dashes, subject at most 60 characters.
msg="$1"
if grep -q -i -E '^(Co-Authored-By|Claude-Session):|Generated with \[?Claude' "$msg"; then
  echo "commit-msg: AI attribution lines are not allowed (see CLAUDE.md)" >&2
  exit 1
fi
if grep -q -E $'—|–' "$msg"; then
  echo "commit-msg: em or en dash found; use a comma, colon, or hyphen" >&2
  exit 1
fi
subject=$(grep -v '^#' "$msg" | sed -n '1p')
if [ "${#subject}" -gt 60 ]; then
  echo "commit-msg: subject longer than 60 characters" >&2
  exit 1
fi
exit 0
