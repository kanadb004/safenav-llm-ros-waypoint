# SafeNav-LLM hardware image: Jetson Orin NX, JetPack 6 (L4T r36.x, Ubuntu 22.04 Jammy).
# Written and reviewed in Phase 9 (PLAN.md section 15); NOT built in this phase, there is no
# Jetson present. Phase 10 builds this on the real device and records what had to change in
# its own report. See docs/hardware/jetson-build.md for the build recipe, expected build time,
# disk requirements, and known failure modes.
#
# Base choice: dustynv/ros:humble-ros-base-l4t-r36.2.0 (or the closest l4t-r36.x tag matching
# the flashed JetPack 6.x version). JetPack 6 moved the Jetson rootfs to Ubuntu 22.04, so ROS 2
# Humble installs from its own Jammy arm64 apt repo exactly as on any other arm64 Ubuntu 22.04
# host; no source rebuild of ROS itself is needed, unlike on JetPack 5 (Ubuntu 20.04, where
# Humble has no Jammy-matching apt repo and dustynv instead ships a custom-built mirror). This
# repository targets JetPack 6 for that reason: see jetson-build.md failure mode 1.
FROM dustynv/ros:humble-ros-base-l4t-r36.2.0 AS core

ARG DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
SHELL ["/bin/bash", "-lc"]

# Nav2, TurtleBot4 hardware runtime (not turtlebot4-simulator, this image never runs Gazebo),
# BT, bag, TTS. Unlike docker/Dockerfile's dev image, no OSRF Gazebo repo and no vendored
# third_party/ros_src build: turtlebot4-navigation and friends have arm64 Jammy apt binaries
# from ROS's own build farm (Humble is Tier 1 on arm64/Ubuntu 22.04), it is only
# turtlebot4-simulator and ros-gz-sim that lack them (see docker/Dockerfile's comment; that
# gap does not apply here because this image does not simulate).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git pkg-config \
    python3-pip python3-colcon-common-extensions python3-rosdep python3-vcstool \
    nlohmann-json3-dev libcurl4-openssl-dev libgflags-dev \
    espeak-ng \
    ros-humble-navigation2 \
    ros-humble-nav2-bringup \
    ros-humble-nav2-simple-commander \
    ros-humble-turtlebot4-description \
    ros-humble-turtlebot4-msgs \
    ros-humble-turtlebot4-navigation \
    ros-humble-turtlebot4-node \
    ros-humble-irobot-create-msgs \
    ros-humble-behaviortree-cpp-v3 \
    ros-humble-pluginlib \
    ros-humble-rosbag2 \
    ros-humble-rosbag2-storage-mcap \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-launch-testing \
    ros-humble-launch-testing-ros \
 && rm -rf /var/lib/apt/lists/*

# llama.cpp tag b10941 (commit 4a89937, the same pin as docker/Dockerfile), built with CUDA
# for the Orin NX's Ampere SM (compute capability 8.7). CMAKE_CUDA_ARCHITECTURES is pinned to
# the exact number rather than left to auto-detection: the Docker build has no GPU visible to
# it (no --gpus/--runtime=nvidia at build time on most Jetson Docker setups), so
# CMAKE_CUDA_ARCHITECTURES=native or a probe-based default would silently fall back to a
# wrong or generic architecture instead of failing loudly. See jetson-build.md failure mode 2.
COPY third_party/llama.cpp /tmp/llama.cpp
RUN cmake -S /tmp/llama.cpp -B /tmp/llama.cpp/build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_SHARED_LIBS=ON \
      -DGGML_CUDA=ON \
      -DCMAKE_CUDA_ARCHITECTURES=87 \
      -DLLAMA_CURL=OFF \
      -DLLAMA_BUILD_TESTS=OFF \
      -DLLAMA_BUILD_EXAMPLES=OFF \
      -DLLAMA_BUILD_TOOLS=ON \
      -DLLAMA_BUILD_SERVER=ON \
      -DCMAKE_INSTALL_PREFIX=/opt/llama.cpp \
 && cmake --build /tmp/llama.cpp/build -j2 \
 && cmake --install /tmp/llama.cpp/build \
 && rm -rf /tmp/llama.cpp
ENV LD_LIBRARY_PATH=/opt/llama.cpp/lib:${LD_LIBRARY_PATH}
ENV PATH=/opt/llama.cpp/bin:${PATH}
ENV CMAKE_PREFIX_PATH=/opt/llama.cpp:${CMAKE_PREFIX_PATH}

# Workspace and runtime defaults. SAFENAV_MODELS_DIR matches bringup-checklist.md and
# planner_params.yaml's hardware profile model_path, which is relative to it.
RUN mkdir -p /ws/ros2_ws /ws/models
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV SAFENAV_MODELS_DIR=/ws/models
COPY docker/ros_entrypoint.sh /ros_entrypoint.sh
COPY docker/safenav_env.sh /etc/profile.d/safenav_env.sh
RUN chmod +x /ros_entrypoint.sh \
 && echo 'source /etc/profile.d/safenav_env.sh' >> /root/.bashrc \
 && echo 'source /etc/profile.d/safenav_env.sh' >> /etc/bash.bashrc
WORKDIR /ws/ros2_ws

# Only semantic_waypoint_planner is colcon-built into this image: safenav_sim (Gazebo,
# loopback simulator) is simulation-only scope and has no reason to ship on the robot.
COPY ros2_ws/src/semantic_waypoint_planner /ws/ros2_ws/src/semantic_waypoint_planner
RUN source /opt/ros/humble/setup.bash \
 && cd /ws/ros2_ws \
 && rosdep update \
 && rosdep install --from-paths src --ignore-src -r -y \
 && colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release
RUN echo 'source /ws/ros2_ws/install/setup.bash' >> /root/.bashrc

# Small debugging utilities (kept last so they never invalidate the layers above)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdb vim tmux htop less iputils-ping net-tools \
 && rm -rf /var/lib/apt/lists/*
